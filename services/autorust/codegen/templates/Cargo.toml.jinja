# generated by AutoRust
[package]
name = "{{package_name}}"
version = "0.21.0"
edition = "2021"
license = "MIT"
description = "generated REST API bindings"
repository = "https://github.com/azure/azure-sdk-for-rust"
homepage = "https://github.com/azure/azure-sdk-for-rust/tree/legacy"
documentation = "https://docs.rs/{{package_name}}"
# Require 1.64.0 for IntoFuture support
# https://blog.rust-lang.org/2022/09/22/Rust-1.64.0.html#enhancing-await-with-intofuture
rust-version = "1.64.0"

[lib]
doctest = false

[dependencies]
azure_openapi_core = { path = "../../../sdk/azure_openapi_core", features = [] }
# azure_core = { path = "../../../sdk/core", version = "0.21", features = [{%- for feature in azure_core_features -%}"{{feature}}", {%- endfor -%}] }
# azure_core = { version = "0.22.0", features = [{%- for feature in azure_core_features -%}"{{feature}}", {%- endfor -%}] }
azure_core = { git = "https://github.com/Azure/azure-sdk-for-rust", branch = "main" }
typespec_client_core = { git = "https://github.com/Azure/azure-sdk-for-rust", branch = "main", features = ["derive"] }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
bytes = "1.3"
futures = "0.3"
time = "0.3"
log = "0.4"
once_cell = "1.18"
async-trait = "0.1"

[dev-dependencies]
azure_identity = { git = "https://github.com/Azure/azure-sdk-for-rust", branch = "main", features = [] }
tokio = { version = "1.23", features = ["macros", "rt-multi-thread"] }
env_logger = "0.10"
anyhow = "1.0"

[package.metadata.docs.rs]
all-features = true

[features]
default = ["default_tag"]
default_tag = ["{{default_tag}}"]
{%- for feature in features %}
"{{feature}}" = []
{%- endfor %}

[lints]
workspace = true
