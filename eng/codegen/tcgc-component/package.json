{
  "name": "@azure/tcgc-component",
  "version": "0.1.0",
  "private": true,
  "description": "WASI component wrapping TypeSpec TCGC for the Rust code generator",
  "type": "module",
  "scripts": {
    "build": "jco componentize src/index.js --wit wit/component.wit --world-name codegen --out tcgc.wasm",
    "clean": "rm -f tcgc.wasm"
  },
  "dependencies": {
    "@typespec/compiler": "^1.10.0",
    "@azure-tools/typespec-client-generator-core": "~0.66.2",
    "@azure-tools/typespec-azure-core": "~0.66.0",
    "@azure-tools/typespec-azure-resource-manager": "~0.66.0",
    "@azure-tools/typespec-http": "^1.10.0",
    "@azure-tools/typespec-rest": "~0.80.0",
    "@azure-tools/typespec-versioning": "~0.80.0"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "^1.17.0",
    "@bytecodealliance/componentize-js": "^0.17.0"
  }
}
